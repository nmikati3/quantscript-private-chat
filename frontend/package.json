{
    "name": "quantscript-frontend-ts",
    "private": true,
    "version": "0.1.1",
    "description": "Frontend and Tauri desktop shell for QuantScript, a private, local-first, offline-by-default chat app.",
    "license": "Apache-2.0",
    "homepage": "https://quantscript.io/",
    "repository": {
      "type": "git",
      "url": "git+https://github.com/nmikati3/quantscript-private-chat.git"
    },
    "bugs": {
      "url": "https://github.com/nmikati3/quantscript-private-chat/issues"
    },
    "engines": {
      "node": ">=20"
    },
    "type": "module",
    "scripts": {
      "dev": "vite",
      "build": "tsc -b && vite build",
      "lint": "eslint .",
      "preview": "vite preview",
      "tauri:dev": "tauri dev",
      "tauri:build": "node scripts/desktop/tauri-build.mjs",
      "tauri:build:fancy-dmg": "node scripts/desktop/tauri-build.mjs --fancy-dmg",
      "desktop:bundle-backend": "node scripts/desktop/bundle-backend.mjs",
      "desktop:build-sidecar": "node scripts/desktop/build-sidecar.mjs",
      "desktop:strip-xattrs": "node scripts/desktop/strip-build-xattrs.mjs",
      "desktop:privacy-scan": "node scripts/desktop/privacy-scan.mjs",
      "desktop:verify": "node scripts/desktop/verify-desktop-setup.mjs",
      "test": "vitest run",
      "test:watch": "vitest",
      "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
      "@tauri-apps/api": "^2.11.0",
      "@tauri-apps/plugin-dialog": "^2.7.0",
      "@tauri-apps/plugin-opener": "^2.5.3",
      "jspdf": "^4.2.1",
      "jspdf-autotable": "^5.0.7",
      "katex": "^0.16.45",
      "marked": "^18.0.3",
      "react": "^19.2.1",
      "react-dom": "^19.2.1",
      "react-markdown": "^10.1.0",
      "rehype-katex": "^7.0.1",
      "remark-gfm": "^4.0.1",
      "remark-math": "^6.0.0"
    },
    "devDependencies": {
      "@eslint/js": "^9.39.1",
      "@tauri-apps/cli": "^2.11.2",
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.3.2",
      "@types/node": "^24.10.1",
      "@types/react": "^19.2.5",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^5.1.1",
      "baseline-browser-mapping": "^2.9.19",
      "eslint": "^9.39.1",
      "eslint-plugin-react-hooks": "^7.0.1",
      "eslint-plugin-react-refresh": "^0.4.24",
      "globals": "^16.5.0",
      "jsdom": "^29.1.1",
      "typescript": "~5.9.3",
      "typescript-eslint": "^8.46.4",
      "vite": "^7.3.5",
      "vitest": "^4.1.6"
    },
    "overrides": {
      "dompurify": "^3.4.12",
      "@babel/core": "^7.29.7",
      "esbuild": "^0.28.1"
    }
  }
  