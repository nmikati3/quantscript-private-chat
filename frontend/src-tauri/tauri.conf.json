{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuantScript",
  "version": "0.1.0",
  "identifier": "com.quantscript.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run desktop:build-sidecar && npm run desktop:bundle-backend && npm run build",
    "beforeBundleCommand": "npm run desktop:strip-xattrs",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuantScript",
        "width": 1440,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob:; font-src 'self'; frame-src 'none'; object-src 'none'; form-action 'self'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "QuantScript",
    "copyright": "Copyright © QuantScript. Licensed under Apache-2.0.",
    "category": "Productivity",
    "shortDescription": "A zero-config, local, private ChatGPT alternative.",
    "longDescription": "QuantScript is a local-first, offline-by-default chat app that runs a Gemma 4 model entirely on your own machine. It auto-detects your RAM and picks the best model that fits.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/quantscript-backend"],
    "resources": [
      "resources/backend",
      "resources/backend-manifest.json",
      "resources/LICENSE",
      "resources/NOTICE"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "15.6"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
