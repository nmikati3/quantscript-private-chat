# QuantScript is a local-only desktop app. The Tauri build does not read any
# of these variables — the sidecar URL and token are wired up at runtime by
# the Rust shell (see `frontend/src-tauri/src/main.rs::start_backend_sidecar`).
#
# The values below only affect the `npm run dev` browser preview, which is
# useful for UI iteration without rebuilding the Tauri binary.

# Where Vite's `/api` dev proxy forwards requests to. Defaults to the local
# uvicorn dev server started with `uvicorn app.api.main:app --port 8000`.
VITE_BACKEND_URL=http://localhost:8000