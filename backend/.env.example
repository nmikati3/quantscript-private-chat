# ── LLM configuration ────────────────────────────────────────
LLAMA_REPO_ID=unsloth/gemma-4-E4B-it-GGUF
LLAMA_FILENAME=gemma-4-E4B-it-Q8_0.gguf
LLAMA_MMPROJ_FILENAME=mmproj-F16.gguf
N_CTX=32768
MAX_TOKENS=8192
# Max user/assistant messages sent to the model per request (older turns dropped)
CHAT_HISTORY_MAX_MESSAGES=5

# Optional: override where chat conversations are stored.
# Default (shared by browser & desktop app):
#   macOS:   ~/Library/Application Support/com.quantscript.desktop/storage/conversations
#   Windows: %APPDATA%/com.quantscript.desktop/storage/conversations
#   Linux:   $XDG_DATA_HOME/com.quantscript.desktop/storage/conversations
# QUANTSCRIPT_CONVERSATIONS_DIR=/absolute/path/to/conversations

# ── Deep research ────────────────────────────────────────────
MAX_TOKENS_COMPRESSION=8192
MAX_TOKENS_FINAL_REPORT=8192
MAX_CONCURRENT_RESEARCH_UNITS=5
MAX_RESEARCHER_ITERATIONS=5

# ── Retrieval ────────────────────────────────────────────────
K_KEYWORD_SEARCH=200
