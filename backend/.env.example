# ── LLM configuration ────────────────────────────────────────
LLAMA_REPO_ID=unsloth/gemma-4-E4B-it-GGUF
LLAMA_FILENAME=gemma-4-E4B-it-Q8_0.gguf
LLAMA_MMPROJ_FILENAME=mmproj-F16.gguf
N_CTX=32768
MAX_TOKENS=8192
# Max user/assistant messages sent to the model per request (older turns dropped)
CHAT_HISTORY_MAX_MESSAGES=5

# Optional: override where chat conversations are stored.
# Default (shared by browser & desktop app):
#   macOS:   ~/Library/Application Support/com.quantscript.desktop/storage/conversations
#   Windows: %APPDATA%/com.quantscript.desktop/storage/conversations
#   Linux:   $XDG_DATA_HOME/com.quantscript.desktop/storage/conversations
# QUANTSCRIPT_CONVERSATIONS_DIR=/absolute/path/to/conversations

# ── Deep research ────────────────────────────────────────────
# These limits AUTO-SCALE to your hardware when left unset: machines with 16 GB+
# run the full profile, while memory-constrained machines (under 16 GB) run a
# lighter deep research so a run finishes without exhausting memory.
# Uncomment any of these to pin an explicit value (an explicit value always wins
# over the auto profile, on every tier).
#
#                                full   lite (low-memory)
# MAX_RESEARCHER_ITERATIONS=     5      2     # supervisor planning rounds
# MAX_RESEARCHER_SEARCHES=       3      2     # web searches per research topic
# RESEARCH_ARTICLES_PER_SEARCH=  5      3     # articles fetched per search
# MAX_TOKENS_COMPRESSION=        8192   4096  # tokens for per-round synthesis
# MAX_TOKENS_FINAL_REPORT=       8192   4096  # tokens for the final report
#
# Low-RAM preset (force the lite profile even on a bigger box, e.g. for speed):
# MAX_RESEARCHER_ITERATIONS=2
# MAX_RESEARCHER_SEARCHES=2
# RESEARCH_ARTICLES_PER_SEARCH=3
# MAX_TOKENS_COMPRESSION=4096
# MAX_TOKENS_FINAL_REPORT=4096
#
# Quality knobs (matter most on lower-precision 4-bit models):
# Near-greedy sampling so the model follows the citation/language rules and stops
# inventing URLs. The report cites sources by number; the verified Sources list is
# rebuilt deterministically from the real fetched links, so links are never broken.
# DEEP_RESEARCH_TEMPERATURE=0.3   # sampling temperature for all deep-research calls
# MAX_REPORT_SOURCES=30           # cap on sources offered to & listed in the report

# ── Retrieval ────────────────────────────────────────────────
K_KEYWORD_SEARCH=200
